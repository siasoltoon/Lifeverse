LIFEVERSE_APP_NAME=LifeVerse
LIFEVERSE_ENVIRONMENT=development
LIFEVERSE_DATABASE_URL=sqlite:///./lifeverse.db
LIFEVERSE_LOG_LEVEL=INFO

# Set this separately when the migration identity differs from the runtime identity.
# LIFEVERSE_MIGRATION_DATABASE_URL=postgresql://migration-user:password@host:5432/database

# Enable snapshot publishing on every API and worker process.
LIFEVERSE_METRICS_PUBLISH_ENABLED=false

# Enable only on the single API instance scraped by Prometheus.
LIFEVERSE_METRICS_EXPORT_ENABLED=false
# Generate a random token with at least 32 characters when metrics export is enabled.
# LIFEVERSE_METRICS_TOKEN=
